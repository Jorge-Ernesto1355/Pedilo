{
    "name": "xento",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "test:e2e:auth": "cypress run --spec 'cypress/e2e/auth/**/*.cy.ts'",
        "test:e2e:auth:open": "cypress open --e2e --browser electron",
        "test:e2e:create-menu:open": "cypress open --e2e --browser electron --spec 'cypress/e2e/create-menu/business-setup.cy.ts'",
        "test:e2e:create-menu:headed": "cypress run --headed --browser electron --spec 'cypress/e2e/create-menu/business-setup.cy.ts'"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@hookform/resolvers": "^5.9.1",
        "@tanstack/react-query": "^5.102.8",
        "@types/leaflet": "^1.9.22",
        "@types/qrcode": "^1.5.6",
        "axios": "^1.20.0",
        "better-auth": "^1.7.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^13.2.0",
        "leaflet": "^1.9.4",
        "leaflet-defaulticon-compatibility": "^0.1.2",
        "lucide-react": "^1.41.0",
        "next": "16.3.4",
        "qrcode": "^1.5.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.87.0",
        "react-leaflet": "^5.0.0",
        "recharts": "^3.10.1",
        "sileo": "^0.1.5",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^3.25.76",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^2.1.9",
        "cypress": "^16.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.3.4",
        "jsdom": "^25.0.1",
        "prettier": "^3.9.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^5",
        "vitest": "^2.1.9"
    }
